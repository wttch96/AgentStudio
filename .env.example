# Agent Studio + CC Switch 本地路由示例
# 使用方式：cp .env.cc-switch.example .env

# DeepSeek 仍负责主脑规划和验收，请填写实际密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 仅用于页面中的本地费用估算；单位为 USD / 1M token。
DEEPSEEK_CACHE_HIT_PRICE_USD_PER_MILLION=0.0028
DEEPSEEK_CACHE_MISS_PRICE_USD_PER_MILLION=0.14
DEEPSEEK_OUTPUT_PRICE_USD_PER_MILLION=0.28

# Claude Agent SDK 请求先进入 CC Switch，再由当前启用的 Provider 转发。
ANTHROPIC_BASE_URL=http://127.0.0.1:15721
ANTHROPIC_AUTH_TOKEN=PROXY_MANAGED
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Web 服务仍然只允许本机访问。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

MAX_CONCURRENT_AGENTS=3
AGENT_MAX_TURNS=12
AGENT_TIMEOUT_SECONDS=900
